Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Only block hidden files and truly sensitive paths
RewriteRule ^\.env - [F,L]
RewriteRule ^\. - [F,L]

# SPA fallback for non-existent files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
